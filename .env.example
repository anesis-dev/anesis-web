# Copy to .env.local and adjust as needed. Every variable here is optional for
# local dev - see the defaults noted below. In a *production* build
# NEXT_PUBLIC_API_URL is required; the rest stay optional.

# Base URL the *browser* uses to reach anesis-server. Can be an absolute URL
# or a same-origin path like "/api/backend" if you rewrite requests through
# Next.js (see API_PROXY_URL below). Defaults to http://localhost:4000.
#
# REQUIRED IN PRODUCTION. src/config/env.ts throws when NODE_ENV=production and
# this is unset or unparseable, rather than falling back to localhost - that
# fallback would silently point every visitor's browser at their own machine.
# Set it in the deployment environment (Vercel project settings), not here.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional. Canonical origin used for metadataBase, canonical links, OpenGraph
# tags, sitemap.xml and robots.txt (src/config/site.ts). On Vercel this is
# derived from VERCEL_PROJECT_PRODUCTION_URL automatically; set it explicitly
# only when self-hosting or when the canonical domain differs from the Vercel
# one. Falls back to https://anesis-dev.vercel.app.
NEXT_PUBLIC_SITE_URL=

# Server-side-only override for where *this Next.js server* forwards API
# calls - both the /api/backend/* rewrite in next.config.ts and any
# server-side fetches in src/api/client.ts. Only needed when proxying to a
# backend at a different address than NEXT_PUBLIC_API_URL implies (e.g. in
# production, where the browser hits a same-origin path but the Next.js
# server itself must reach the real anesis-server origin).
API_PROXY_URL=http://localhost:4000

# Optional. Local filesystem path to a checkout of registry/addons, used
# only by the local addon catalog reader. Defaults to "../addons" relative
# to this app's working directory.
ANESIS_ADDONS_DIR=
